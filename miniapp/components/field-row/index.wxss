.fr-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--tss-line);
}

.fr-row:last-child {
  border-bottom: none;
}

.fr-label {
  color: var(--tss-text-sub);
  font-size: 26rpx;
  min-width: 220rpx;
  flex-shrink: 0;
}

.fr-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.fr-text {
  font-size: 28rpx;
  color: var(--tss-text);
}

.fr-missing {
  font-size: 26rpx;
  color: var(--tss-text-weak);
}

.fr-unverified {
  display: inline-block;
  margin-left: 12rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #f0f2f6;
  color: var(--tss-info);
  font-size: 20rpx;
  line-height: 1.8;
}
