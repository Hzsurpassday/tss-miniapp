.dt-line {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--tss-line);
}

.dt-line:last-child {
  border-bottom: none;
}

.dt-line-title {
  font-size: 26rpx;
  color: var(--tss-text-sub);
  padding: 8rpx 0;
}

.dt-empty {
  font-size: 24rpx;
  color: var(--tss-text-weak);
  padding: 16rpx 0;
}

.dt-actions {
  display: flex;
  flex-wrap: wrap;
}

.dt-action {
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.dt-notes {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.dt-trace {
  margin-top: 8rpx;
  font-size: 22rpx;
  text-decoration: underline;
}
