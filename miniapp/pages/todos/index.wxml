<view class="tss-page">

  <view class="tss-notice" wx:if="{{sampleBanner}}">{{sampleBanner}}</view>

  <view class="tss-notice danger" wx:if="{{errorText}}">
    <view>{{errorText}}</view>
    <view wx:if="{{traceId}}" class="td-trace" bindtap="onCopyTraceId">traceId：{{traceId}}（点击复制）</view>
  </view>

  <!-- 未绑定引导：不显示空列表冒充「零待办」 -->
  <view class="tss-card" wx:if="{{needBinding}}">
    <view class="tss-card-title">尚未绑定 ERP 员工</view>
    <view class="tss-text-sub">当前微信身份没有绑定 ERP 账号，因此无法读取待办。绑定后即可查看。</view>
    <view class="tss-btn" bindtap="onGoProfile">去绑定</view>
  </view>

  <block wx:if="{{!needBinding}}">

  <!-- 搜索 -->
  <view class="td-search">
    <input class="td-input" placeholder="搜索单号 / 标题 / 相对方" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onKeywordConfirm" />
    <text class="td-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">清空</text>
  </view>

  <!-- 分类 -->
  <scroll-view class="td-tabs" scroll-x="true">
    <view class="td-tab {{item.key === docType ? 'is-active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTabTap">
      {{item.label}}
    </view>
  </scroll-view>

  <freshness-bar meta="{{meta}}" extra="共约 {{totalApproxText}} 条" />

  <!-- 列表 -->
  <view class="td-list">
    <view class="tss-card td-item" wx:for="{{items}}" wx:key="taskNum" data-tasknum="{{item.taskNum}}" bindtap="onItemTap">
      <view class="td-item-head">
        <text class="td-title">{{item.title}}</text>
        <text class="tss-tag gray">{{item.docTypeText}}</text>
      </view>
      <view class="td-item-line">
        <text class="td-label">单号</text>
        <text class="td-value">{{item.billNo}}</text>
      </view>
      <view class="td-item-line">
        <text class="td-label">相对方</text>
        <text class="td-value">{{item.counterpartyText}}</text>
      </view>
      <view class="td-item-line">
        <text class="td-label">金额</text>
        <text class="td-value td-amount">{{item.amountText}}</text>
      </view>
      <view class="td-item-line">
        <text class="td-label">当前节点</text>
        <text class="td-value">{{item.currentNodeName}}</text>
      </view>
      <view class="td-item-foot">
        <text class="td-status {{item.statusClass}}">{{item.statusText}}</text>
        <text class="td-time">{{item.updatedAtText}}</text>
      </view>
    </view>
  </view>

  <empty-state visible="{{emptyVisible && !loading}}" text="{{emptyText}}" hint="下拉可刷新" />
  <view class="tss-loading" wx:if="{{loading}}">加载中…</view>
  <view class="tss-loading" wx:elif="{{loadingMore}}">正在加载更多…</view>
  <view class="tss-loading" wx:elif="{{!hasMore && items.length > 0}}">没有更多了</view>
  </block>
</view>
